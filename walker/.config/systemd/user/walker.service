# Persistent Walker instance. Started explicitly from hyprland.lua (like
# waybar/emacs/dropbox), not via `systemctl --user enable` -- this session
# never starts graphical-session.target, so no PartOf=/After= on it.
#
# The service is not optional: Walker's clipboard provider only loads when
# Walker runs as a service, so SUPER+V depends on this being up.
#
# On relogin the old instance dies on a broken Wayland pipe and Restart=
# kicks in during the compositor handoff, before the new wayland socket
# exists -- Walker would crash-loop "Failed to open display" and nearly
# hit the start limit. ExecStartPre blocks each attempt until the socket
# is back; the widened start limit is a backstop for the handoff window.
[Unit]
Description=Walker application launcher (persistent GTK service)
Documentation=https://github.com/abenz1267/walker
Wants=elephant.service
After=elephant.service
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY:-wayland-1}" ] && exit 0; sleep 0.5; done; exit 1'
ExecStart=/usr/bin/walker --gapplication-service
Restart=on-failure
RestartSec=2
