{
  "enabledPlugins": {
    "emacs-skills@xenodium-emacs-skills": true
  },
  "skillOverrides": {
    "emacs-skills:xcode-build-device": "off",
    "emacs-skills:xcode-run-device": "off",
    "emacs-skills:xcode-build-simulator": "off",
    "emacs-skills:xcode-run-simulator": "off",
    "emacs-skills:swiftui-preview": "off"
  },
  "extraKnownMarketplaces": {
    "xenodium-emacs-skills": {
      "source": {
        "source": "github",
        "repo": "xenodium/emacs-skills"
      }
    }
  },
  "theme": "light",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(echo:*)",
      "Bash(command:*)",
      "Bash(col:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",

      "Bash(gitlint:*)",

      "Bash(pwd:*)",
      "Bash(which:*)",
      "Bash(whoami:*)",
      "Bash(date:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",

      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git check-ignore:*)",

      "Bash(journalctl:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl --user status:*)",
      "Bash(systemctl is-active:*)",
      "Bash(loginctl show-session:*)",
      "Bash(loginctl show-seat:*)",
      "Bash(loginctl list-sessions:*)",

      "Bash(pacman -Qi:*)",
      "Bash(pacman -Q:*)",
      "Bash(pacman -Qq:*)",
      "Bash(pacman -Qo:*)",
      "Bash(pacman -Si:*)",

      "Bash(hyprctl monitors:*)",
      "Bash(hyprctl binds:*)",

      "Bash(luacheck:*)",
      "Bash(cliphist list:*)",
      "Bash(findmnt:*)",
      "Bash(zcat:*)",

      "mcp__claude_ai_Gmail__search_threads",

      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm un *)",
      "Bash(npm rm *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)",
      "Bash(yarn remove *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm uninstall *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",

      "Bash(rm *)",
      "Bash(rmdir *)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.md) prettier --write \"$f\" >/dev/null 2>&1; markdownlint \"$f\";; esac; }",
            "statusMessage": "Formatting & linting markdown..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.json) prettier --write \"$f\" >/dev/null 2>&1; jsonlint \"$f\";; esac; }",
            "statusMessage": "Formatting & linting JSON..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.sh) shfmt -w \"$f\" >/dev/null 2>&1; shellcheck \"$f\";; esac; }",
            "statusMessage": "Formatting & linting shell..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) ruff format \"$f\" >/dev/null 2>&1; ruff check \"$f\";; esac; }",
            "statusMessage": "Formatting & linting Python..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.yaml|*.yml) prettier --write \"$f\" >/dev/null 2>&1; yamllint \"$f\";; esac; }",
            "statusMessage": "Formatting & linting YAML..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.el) out=$(emacsclient --eval \"(with-temp-buffer (insert-file-contents \\\"$f\\\") (emacs-lisp-mode) (check-parens))\" 2>&1); ec=$?; if [ \"$ec\" -ne 0 ]; then echo \"$out\"; fi; exit \"$ec\";; esac; }",
            "statusMessage": "Checking elisp parens..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.lua) stylua \"$f\" >/dev/null 2>&1; (cd \"$(dirname \"$f\")\" && luacheck \"$(basename \"$f\")\");; esac; }",
            "statusMessage": "Formatting & linting Lua..."
          }
        ]
      }
    ]
  }
}
