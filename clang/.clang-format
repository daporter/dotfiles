# -*- mode: yaml-ts -*-
---
AccessModifierOffset: -4
AlignConsecutiveAssignments:
  Enabled: true
  AlignCompound: true
AlignConsecutiveDeclarations:
  Enabled: true
AlignConsecutiveMacros:
  Enabled: true
AlignEscapedNewlines: Left
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 1
AllowAllParametersOfDeclarationOnNextLine: false
AllowShortFunctionsOnASingleLine: None
BraceWrapping:
  AfterFunction: true
  AfterNamespace: true
BreakBeforeBraces: Custom
BreakBeforeTernaryOperators: false
BreakConstructorInitializers: BeforeComma
BreakStringLiterals: false
ConstructorInitializerIndentWidth: 8
ContinuationIndentWidth: 8
Cpp11BracedListStyle: false
FixNamespaceComments: false
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"'
    Priority: 1
  - Regex: ".*"
    Priority: 2
IndentGotoLabels: false
IndentWidth: 8
# KeepEmptyLinesAtTheStartOfBlocks was renamed/restructured upstream; this is
# its replacement (AtStartOfBlock: false is the same intent as the old key).
KeepEmptyLines:
  AtStartOfBlock: false
ObjCBlockIndentWidth: 8
ObjCSpaceAfterProperty: true
PenaltyBreakAssignment: 10
PenaltyBreakBeforeFirstCallParameter: 30
PenaltyBreakComment: 10
PenaltyBreakFirstLessLess: 0
PenaltyBreakString: 10
PenaltyExcessCharacter: 100
SeparateDefinitionBlocks: Always
SpaceBeforeParens: ControlStatementsExceptForEachMacros
SpacesBeforeTrailingComments: 4
SpacesInContainerLiterals: false
# Must match IndentWidth/ContinuationIndentWidth so each indent level is
# exactly one tab character under UseTab: AlignWithSpaces, rather than a
# tab-plus-spaces mix -- same reasoning as tab-width/sh-basic-offset in
# emacs/.emacs.d/init.el.
TabWidth: 8
UseTab: AlignWithSpaces
